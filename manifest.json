{
  "manifest_version": 3,
  "name": "知行视频总结",
  "version": "5.4.0",
  "description": "提取 B站、YouTube、抖音字幕或音频，可选图片拼图，发送到 ChatGPT / AI Studio",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "offscreen",
    "nativeMessaging",
    "scripting"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://api.bilibili.com/*",
    "https://aisubtitle.hdslb.com/*",
    "https://aistudio.google.com/*",
    "https://*.bilivideo.com/*",
    "https://*.bilivideo.cn/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://youtu.be/*",
    "https://www.douyin.com/*",
    "https://v.douyin.com/*",
    "https://www.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://i.ytimg.com/*",
    "https://*.douyinpic.com/*",
    "https://*.byteimg.com/*",
    "https://*.pstatp.com/*",
    "https://*.ggpht.com/*",
    "https://*.douyincdn.com/*",
    "https://*.ibytedtos.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/a3-v1-16.png",
      "32": "icons/a3-v1-32.png",
      "48": "icons/a3-v1-48.png",
      "128": "icons/a3-v1-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "chatgpt-library-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/list/*"
      ],
      "js": [
        "bilibili-content-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/list/*"
      ],
      "js": [
        "task-diagnostics.js",
        "error-reporter.js",
        "bilibili-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "task-diagnostics.js",
        "error-reporter.js",
        "conversation-binding.js",
        "attachment-utils.js",
        "chatgpt-content.js"
      ]
    },
    {
      "matches": [
        "https://aistudio.google.com/*"
      ],
      "js": [
        "task-diagnostics.js",
        "error-reporter.js",
        "attachment-utils.js",
        "aistudio-transcript.js",
        "attachment-transfer.js",
        "aistudio-content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.douyin.com/*"
      ],
      "js": [
        "task-diagnostics.js",
        "error-reporter.js",
        "platforms.js",
        "platform-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "prompt_chatgpt.txt",
        "prompt_aistudio.txt"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://aistudio.google.com/*"
      ]
    },
    {
      "resources": [
        "lib/transformers-3.8.1.min.js",
        "lib/ort-wasm-simd-threaded-3.8.1.jsep.mjs"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/a3-v1-16.png",
    "32": "icons/a3-v1-32.png",
    "48": "icons/a3-v1-48.png",
    "128": "icons/a3-v1-128.png"
  },
  "key": "",
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  }
}
